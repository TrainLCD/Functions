{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainlcd-worker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-06",
  "compatibility_flags": ["nodejs_compat"],

  // --- 既定（dev）。`wrangler deploy` / `wrangler dev` はこの設定を使う ---
  "observability": { "enabled": true },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "ai": { "binding": "AI" },

  // KV / R2 / Queue の id・bucket 名は `wrangler kv namespace create` 等で発行後に差し替える
  "kv_namespaces": [
    { "binding": "TTS_KV", "id": "aebb675c3c27417eac6cd5a5b5a51c60" },
    { "binding": "CONFIG_KV", "id": "538a8bc7db6b463089bf9327bc2e1483" },
    { "binding": "STATE_KV", "id": "d99ba5c23127456f8e1e928be1731876" }
  ],

  "r2_buckets": [
    { "binding": "TTS_BUCKET", "bucket_name": "trainlcd-tts-dev" },
    { "binding": "UPLOAD_BUCKET", "bucket_name": "trainlcd-uploads-dev" }
  ],

  "queues": {
    "producers": [
      { "binding": "FEEDBACK_QUEUE", "queue": "feedback-triage-dev" }
    ],
    "consumers": [
      { "queue": "feedback-triage-dev", "max_batch_size": 5, "max_retries": 3 }
    ]
  },

  // エージェントの駅検索（stationsByName）は同一アカウントの sapi-bff を Service Binding で呼ぶ
  "services": [{ "binding": "SAPI_BFF", "service": "sapi-bff-stg" }],

  "vars": {
    "GOOGLE_PLAY_PACKAGE_NAME": "me.tinykitten.trainlcd",
    "AI_TRIAGE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // --- TTS（/tts）---
    // gpt-4o-mini-tts は SSML 非対応。声色・速度・間の取り方は instructions で指示する。
    // ボイスは多言語対応のため、日英とも同じ女性声にして一人のアナウンサーに揃える。
    "TTS_MODEL": "gpt-4o-mini-tts",
    "TTS_JA_VOICE_NAME": "nova",
    "TTS_EN_VOICE_NAME": "nova",
    "TTS_INSTRUCTIONS_JA": "鉄道の車内自動放送のアナウンサーとして、落ち着いた丁寧な女性の声で読み上げてください。一定の速さを保ち、句読点では短く間を取ります。駅名や路線名は一語ずつ明瞭に発音し、感情を込めすぎず、事務的で聞き取りやすい調子にしてください。",
    "TTS_INSTRUCTIONS_EN": "Read this as an automated train announcement in a calm, polite female voice. Keep a steady pace, pause briefly at commas, and pronounce station and line names clearly. Stay neutral and business-like rather than expressive.",
    "SESSION_TOKEN_TTL_SECONDS": "3600",
    "UPLOAD_PUBLIC_BASE_URL": "https://uploads-dev.trainlcd.app",
    "FEW_SHOT_KV_KEY": "config:fewshot",
    "FEW_SHOT_LIMIT": "12",
    "FEW_SHOT_PER_EX_MAX": "800",
    // --- AI エージェント（/agent/chat）---
    // モデルは "anthropic:<model>" | "openai:<model>"。比較検証で差し替える
    "AGENT_MODEL": "openai:gpt-5.6-luna",
    "AGENT_GATE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AGENT_FAQ_KV_KEY": "config:agent-faq",
    // config:remote の agent_daily_turn_limit があればそちらが優先（デプロイなしで調整可）
    "AGENT_DAILY_TURN_LIMIT": "60",
    // Cloudflare AI Gateway 経由にする場合は
    // "https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>" を設定（空なら各社 API 直行）
    "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/38d776d9385fbdbad95832d383b63e7b/trainlcd-agent-dev",
    // dev のみ: LangSmith トレーシング（会話本文を含むため本番では必ず "false" のまま）
    "LANGSMITH_TRACING": "true"
  },

  // secrets（`wrangler secret put <NAME>` で投入。コミットしない）:
  //   SESSION_JWT_SECRET / GOOGLE_PLAY_SA_KEY / APPSTORE_CONNECT_KEY /
  //   OCTOKIT_PAT / DISCORD_CS_WEBHOOK_URL / DISCORD_CRASH_WEBHOOK_URL / DISCORD_REVIEW_WEBHOOK_URL /
  //   ANTHROPIC_API_KEY / OPENAI_API_KEY / LANGSMITH_API_KEY

  "env": {
    "production": {
      "name": "trainlcd-worker",
      "observability": { "enabled": true },
      "triggers": { "crons": ["0 * * * *"] },
      "ai": { "binding": "AI" },
      "kv_namespaces": [
        { "binding": "TTS_KV", "id": "b42928fa3ed64bdcacb8c8749b528f24" },
        { "binding": "CONFIG_KV", "id": "dc9c94a546d549e5b3ac02dfa94717a0" },
        { "binding": "STATE_KV", "id": "a030d194835843f98cbaf368f0615a83" }
      ],
      "r2_buckets": [
        { "binding": "TTS_BUCKET", "bucket_name": "trainlcd-tts" },
        { "binding": "UPLOAD_BUCKET", "bucket_name": "trainlcd-uploads" }
      ],
      "queues": {
        "producers": [
          { "binding": "FEEDBACK_QUEUE", "queue": "feedback-triage" }
        ],
        "consumers": [
          { "queue": "feedback-triage", "max_batch_size": 5, "max_retries": 3 }
        ]
      },
      "services": [{ "binding": "SAPI_BFF", "service": "sapi-bff" }],
      "vars": {
        "GOOGLE_PLAY_PACKAGE_NAME": "me.tinykitten.trainlcd",
        "AI_TRIAGE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
        // --- TTS（/tts）---
        "TTS_MODEL": "gpt-4o-mini-tts",
        "TTS_JA_VOICE_NAME": "nova",
        "TTS_EN_VOICE_NAME": "nova",
        "TTS_INSTRUCTIONS_JA": "鉄道の車内自動放送のアナウンサーとして、落ち着いた丁寧な女性の声で読み上げてください。一定の速さを保ち、句読点では短く間を取ります。駅名や路線名は一語ずつ明瞭に発音し、感情を込めすぎず、事務的で聞き取りやすい調子にしてください。",
        "TTS_INSTRUCTIONS_EN": "Read this as an automated train announcement in a calm, polite female voice. Keep a steady pace, pause briefly at commas, and pronounce station and line names clearly. Stay neutral and business-like rather than expressive.",
        "SESSION_TOKEN_TTL_SECONDS": "3600",
        "UPLOAD_PUBLIC_BASE_URL": "https://uploads.trainlcd.app",
        "FEW_SHOT_KV_KEY": "config:fewshot",
        "FEW_SHOT_LIMIT": "12",
        "FEW_SHOT_PER_EX_MAX": "800",
        // --- AI エージェント（/agent/chat）---
        "AGENT_MODEL": "openai:gpt-5.6-luna",
        "AGENT_GATE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
        "AGENT_FAQ_KV_KEY": "config:agent-faq",
        // config:remote の agent_daily_turn_limit があればそちらが優先（デプロイなしで調整可）
        "AGENT_DAILY_TURN_LIMIT": "60",
        "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/38d776d9385fbdbad95832d383b63e7b/trainlcd-agent",
        // 本番では LangSmith トレーシングを必ず無効にする（会話本文が送信されるため）
        "LANGSMITH_TRACING": "false"
      }
    }
  }
}
